    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Busca camisetas y su stock real en la base de datos. Todos los filtros son opcionales; deja vacío lo que el cliente no haya dicho. Devuelve inventario_id, precio, jugador/número, talla y stock (0 = agotada). Úsala SIEMPRE antes de hablar de disponibilidad o precio.",
        "operation": "executeQuery",
        "query": "SELECT * FROM buscar_productos(NULLIF($1,''), NULLIF($2,''), NULLIF($3,''), NULLIF($4,''), NULLIF($5,''), NULLIF($6,'')::numeric);",
        "options": {
          "queryReplacement": "={{ [ $fromAI('equipo', 'Equipo o alias (ej. barça, real madrid). Vacío si no se indicó', 'string', ''), $fromAI('temporada', 'Formato AAAA/AA, ej. 2025/26. Vacío si no se indicó', 'string', ''), $fromAI('tipo', 'local, visitante, tercera, portero, especial o retro. Vacío si no se indicó', 'string', ''), $fromAI('jugador', 'Nombre del jugador. Vacío si no se indicó', 'string', ''), $fromAI('talla', 'XS, S, M, L, XL o XXL. Vacío si no se indicó', 'string', ''), $fromAI('precio_max', 'Precio máximo numérico. Vacío si no se indicó', 'string', '') ] }}"
        }
